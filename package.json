{
  "name": "mikrostats",
  "version": "2.0.0",
  "description": "Lightweight real-time monitoring dashboard for MikroTik SwOS / RouterOS devices",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "test": "node --test test/unit.test.js test/history.test.js test/transit.test.js",
    "test:all": "node --test test/",
    "test:unit": "node --test test/unit.test.js",
    "test:history": "node --test test/history.test.js",
    "test:ui": "node --test test/ui.test.js",
    "soak": "node test/soak.js 4 --sim"
  },
  "engines": {
    "node": ">=26"
  },
  "keywords": [
    "mikrotik",
    "swos",
    "routeros",
    "monitoring",
    "dashboard"
  ],
  "license": "ISC",
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "jsdom": "^31.0.0"
  }
}
